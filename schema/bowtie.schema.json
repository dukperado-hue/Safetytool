{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/safetytool/bowtie.schema.json",
  "title": "Safetytool bowtie model",
  "description": "Schema for safetytool.bowtie/1. Structural rules beyond this schema (dangling references, duplicate ids) are checked by `node cli/safetytool.js validate`.",
  "type": "object",
  "required": [
    "schema",
    "meta",
    "hazard",
    "topEvent",
    "threats",
    "consequences",
    "controls",
    "escalations",
    "escalationControls"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "safetytool.bowtie/1"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "illustrative": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "modelId": {
          "type": "string",
          "description": "Stable model identity (interchange layer). Never changes once assigned."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Counts exports whose semantic content differed from the previous export."
        },
        "lastExportHash": {
          "type": "string",
          "description": "SHA-256 of the canonical content at the last export (timestamps excluded)."
        },
        "transformations": {
          "type": "array",
          "description": "History of guided transformations or imports that produced this model.",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "hazard": {
      "$ref": "#/$defs/textNode"
    },
    "topEvent": {
      "$ref": "#/$defs/textNode"
    },
    "threats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/threat"
      }
    },
    "consequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consequence"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "escalations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/escalation"
      }
    },
    "escalationControls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/escalationControl"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "correctiveActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correctiveAction"
      }
    },
    "adrep": {
      "$ref": "#/$defs/adrep"
    },
    "erc": {
      "type": [
        "object",
        "null"
      ],
      "description": "Analyst-chosen ERC answers (never computed). outcome = row id of the matrix in data/erc-matrix.json; barriers = column id.",
      "properties": {
        "matrix": {
          "type": "string"
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "barriers": {
          "enum": [
            "effective",
            "limited",
            "minimal",
            "notEffective",
            null
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rating5": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "rating4": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4
    },
    "textNode": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "observableCriteria": {
          "type": "string"
        }
      }
    },
    "threat": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "exposure": {
          "$ref": "#/$defs/rating5"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "consequence": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/rating5"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "id",
        "side",
        "text",
        "order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "enum": [
            "prevent",
            "recover"
          ]
        },
        "threatId": {
          "type": [
            "string",
            "null"
          ]
        },
        "consequenceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "sharedWith": {
          "description": "Optional. Extra lanes this ONE control also stands on: other threat ids (side prevent) or consequence ids (side recover). Not the control's own lane.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "text": {
          "type": "string"
        },
        "function": {
          "enum": [
            "eliminate",
            "prevent",
            "reduce",
            "mitigate",
            null
          ]
        },
        "type": {
          "enum": [
            "policy",
            "equipment",
            "warning",
            "human",
            "automated",
            null
          ]
        },
        "critical": {
          "type": "boolean"
        },
        "adequacy": {
          "$ref": "#/$defs/rating4"
        },
        "reliability": {
          "$ref": "#/$defs/rating4"
        },
        "owner": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "status": {
          "enum": [
            "effective",
            "degraded",
            "failed",
            "unknown",
            null
          ]
        },
        "degradedLogic": {
          "enum": [
            "blocks",
            "fails",
            null
          ]
        },
        "assurance": {
          "type": "object",
          "properties": {
            "performanceStandard": {
              "type": "string"
            },
            "verification": {
              "type": "string"
            },
            "lastVerified": {
              "type": "string",
              "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
            },
            "nextReview": {
              "type": "string",
              "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
            },
            "assessedBy": {
              "type": "string",
              "description": "Who made the current assessment (a name or a role)."
            },
            "assessedOn": {
              "type": "string",
              "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
            },
            "assessmentNotes": {
              "type": "string"
            },
            "history": {
              "type": "array",
              "description": "Append-only record of assessments. Entries are copies of the state at the time and are never edited.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recordedAt": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "effective",
                      "degraded",
                      "failed",
                      "unknown"
                    ]
                  },
                  "degradedLogic": {
                    "enum": [
                      "blocks",
                      "fails",
                      null
                    ]
                  },
                  "assessedBy": {
                    "type": "string"
                  },
                  "assessedOn": {
                    "type": "string",
                    "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "lastVerified": {
                    "type": "string"
                  },
                  "performanceStandard": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "required": [
        "id",
        "controlId",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "controlId": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "escalationControl": {
      "type": "object",
      "required": [
        "id",
        "escalationId",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "escalationId": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "OBSERVED",
            "ASSESSED",
            "HYPOTHESISED"
          ]
        },
        "source": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reference": {
          "type": "string"
        },
        "limitation": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        },
        "evidenceType": {
          "enum": [
            "inspection",
            "audit",
            "test",
            "measurement",
            "report",
            "document",
            "interview",
            "other",
            "",
            null
          ],
          "description": "What sort of record this is. Optional. It says nothing about what the record proves."
        },
        "description": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string",
          "description": "When this record was created in the tool. Not the observation date (see `date`)."
        },
        "recordedBy": {
          "type": "string"
        }
      }
    },
    "correctiveAction": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "description": "Work to fix a barrier deficiency. Its status is separate from the barrier's assurance state: closing an action never changes the barrier.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "controlId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The barrier (control) this action is about. null if the barrier was deleted (see formerControl)."
        },
        "formerControl": {
          "type": "object"
        },
        "finding": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "ownerRole": {
          "type": "string"
        },
        "dueDate": {
          "type": "string",
          "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "implemented",
            "verified",
            "closed",
            "cancelled"
          ]
        },
        "completionEvidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "closedAt": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "OBSERVED",
            "ASSESSED",
            "HYPOTHESISED"
          ]
        },
        "owner": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "howToVerify": {
          "type": "string"
        },
        "impactIfFalse": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        }
      }
    },
    "adrep": {
      "type": "object",
      "properties": {
        "occurrenceCategoryIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "eventTypeIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    }
  }
}
