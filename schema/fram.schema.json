                            },
                            "via": {
                              "type": "string"
                            },
                            "from": {
                              "type": "object",
                              "properties": {
                                "modelId": {
                                  "type": "string"
                                },
                                "entityId": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "precondition": {
                "type": "object",
                "required": [
                  "status",
                  "items"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unknown",
                      "described",
                      "none"
                    ]
                  },
                  "items": {
                    "type": "array",
