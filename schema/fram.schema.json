            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "object",
                "required": [
                  "status",
                  "items"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unknown",
                      "described",
                      "none"
                    ]
                  },
                  "items": {
                    "type": "array",
