{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dukperado-hue.github.io/Safetytool/schema/fram.schema.json",
  "title": "Safetytool FRAM functional model (safetytool.fram/1)",
  "type": "object",
  "description": "FRAM after Hollnagel (2012): functions with six aspects, couplings from an Output to another aspect, variability DESCRIPTIONS. No scores, probabilities or resonance values.",
  "required": [
    "schema",
    "meta",
    "activity",
    "functions",
    "couplings"
  ],
  "properties": {
    "schema": {
      "const": "safetytool.fram/1"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "illustrative": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "modelId": {
          "type": "string",
          "description": "Stable model identity (interchange layer). Never changes once assigned."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Counts exports whose semantic content differed from the previous export."
        },
        "lastExportHash": {
          "type": "string",
          "description": "SHA-256 of the canonical content at the last export (timestamps excluded)."
        },
        "transformations": {
          "type": "array",
          "description": "History of guided transformations or imports that produced this model.",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "activity": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "string"
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "aspects"
        ],
