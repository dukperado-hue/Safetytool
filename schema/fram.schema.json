                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "prov": {
                          "type": "object",
                          "description": "Origin of an element: analyst, a cited report, or a Safetytool transformation (a suggestion until reviewed).",
                          "properties": {
                            "origin": {
                              "enum": [
                                "analyst",
                                "reported",
                                "generated"
                              ]
                            },
                            "reviewed": {
                              "type": "boolean"
                            },
                            "via": {
                              "type": "string"
                            },
                            "from": {
                              "type": "object",
