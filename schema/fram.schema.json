          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
